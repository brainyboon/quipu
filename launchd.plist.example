<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Background maintenance for macOS. It runs from launchd, never from a hook:
     Claude Code kills a hook's process group when the hook exits, so a job started
     from a hook dies with it.

     1. Copy to ~/Library/LaunchAgents/quipu.maintain.plist
     2. Replace every REPLACE_ME
     3. launchctl load ~/Library/LaunchAgents/quipu.maintain.plist

     On Linux, a cron line does the same job:
     */10 * * * * QUIPU_ROOT=... python3 /path/to/quipu/src/maintain.py run -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>quipu.maintain</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>python3</string>
        <string>REPLACE_ME/path/to/quipu/src/maintain.py</string>
        <string>run</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>QUIPU_ROOT</key>
        <string>REPLACE_ME/.claude/projects/REPLACE_ME-project-slug/memory</string>
        <key>QUIPU_LOGS</key>
        <string>REPLACE_ME/.claude/quipu/logs</string>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>
    <key>StartInterval</key>
    <integer>600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>Nice</key>
    <integer>10</integer>
    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
